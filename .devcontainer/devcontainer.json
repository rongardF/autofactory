{
  "name": "Workstation",
  "workspaceFolder": "/workspaces/autofactory",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.pylance",
        "Ranch-Hand-Robotics.rde-pack",
        "ms-vscode-remote.remote-containers",
        "ms-azuretools.vscode-docker",
        "github.copilot-chat",
        "openai.chatgpt"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/opt/venv/bin/python3",
        "python.analysis.extraPaths": [
          "${workspaceFolder}/install/lib/python3.12/site-packages",
          "${workspaceFolder}/install/lib/python3/site-packages"
        ],
        "editor.formatOnSave": true,
        "editor.rulers": [
          100
        ],
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff"
        }
      }
    }
  },
  "dockerComposeFile": [
    "compose.yaml",
    ".generated/compose.json"
  ],
  "service": "devcontainer",
  "initializeCommand": [
    "python3",
    ".devcontainer/scripts/configure.py"
  ],
  "postCreateCommand": "git config --global --add safe.directory ${containerWorkspaceFolder}",
  "overrideCommand": false,
  "shutdownAction": "stopCompose",
  "remoteUser": "ros",
  "updateRemoteUserUID": true,
  "remoteEnv": {
    "CODEX_HOME": "/home/ros/.codex"
  }
}
