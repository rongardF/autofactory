<?xml version="1.0" ?>

<sdf version="1.6">
    <world name="TEST_WORLD">
        <physics name="1ms" type="dart">
            <max_step_size>0.001</max_step_size>      <!-- 1ms step size for precision -->
            <real_time_factor>1.0</real_time_factor>  <!-- Run in real-time -->
            <dart>
                <collision_detector>fcl</collision_detector>  <!-- dart | fcl | bullet | ode -->
                <solver>
                    <solver_type>dantzig</solver_type>       <!-- pgs | dantzig -->
                </solver>
            </dart>
        </physics>

        <!-- World gravity (world-level, not a physics-plugin child) -->
        <gravity>0.0 0.0 -9.8</gravity>

        <!-- Physics system plugin. Only <engine><filename> is honored here; it
             just selects which gz-physics engine library to load. All tuning
             lives in the <physics> element above. -->
        <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
            <engine>
                <filename>libgz-physics-dartsim-plugin.so</filename>
            </engine>
        </plugin>

        <!-- Plugin for handling user commands -->
        <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands">
        </plugin>

        <!-- Plugin for broadcasting scene updates -->
        <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster">
        </plugin>

        <!-- Plugin for handling sensors like the LIDAR -->
        <!-- Using ogre (1.x) instead of ogre2 for better compatibility with software
         rendering (llvmpipe / XRDP). Switch to ogre2 if GPU passthrough is available. -->
        <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
            <render_engine>ogre</render_engine>
        </plugin>

        <!-- To add realistic gravity, do: 0.0 0.0 -9.8, otherwise do 0.0 0.0 0.0 -->
        <!-- <gravity>0.0 0.0 -9.8</gravity> -->

        <!-- Local directional light (replaces the remote Fuel Sun model to avoid network fetches) -->
        <light type="directional" name="sun">
            <cast_shadows>true</cast_shadows>
            <pose>0 0 10 0 0 0</pose>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
            <attenuation>
                <range>1000</range>
                <constant>0.9</constant>
                <linear>0.01</linear>
                <quadratic>0.001</quadratic>
            </attenuation>
            <direction>-0.5 0.1 -0.9</direction>
        </light>

        <!-- Define scene properties -->
        <scene>
            <shadows>false</shadows>
        </scene>

        <include>
            <uri>model://ground</uri>
            <name>GROUND</name>
        </include>

        <!-- Everything the joint touches lives INSIDE one model. A joint must be
             owned by a model for Gazebo to show its type in the Component
             Inspector and for the JointPositionController to drive it. A
             world-scoped joint between two separate models (the previous setup)
             is owned by no model, which is why the joint type was blank and it
             could not be moved. -->
        <model name="linear_stage">
            <!-- Fixed base (the blue box) -->
            <link name="base_link">
                <inertial>
                    <mass>1.0</mass>
                    <!-- inertia of a solid box 0.6 x 0.5 x 0.02 m: I = m/12*(a²+b²) -->
                    <inertia>
                        <ixx>0.02104</ixx>
                        <ixy>0</ixy>
                        <ixz>0</ixz>
                        <iyy>0.02104</iyy>
                        <iyz>0</iyz>
                        <izz>0.04167</izz>
                    </inertia>
                </inertial>
                <collision name="collision">
                    <geometry>
                        <box>
                            <size>0.1 0.1 0.1</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>0.1 0.1 0.1</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.2 0.5 0.8 1</ambient>
                        <diffuse>0.2 0.5 0.8 1</diffuse>
                    </material>
                </visual>
                <pose>0.0 0.0 0.05 0 0 0</pose>
            </link>

            <!-- Anchor the base to the world so only the sliding part moves.
                 (Replaces <static>true</static>, which cannot host a movable joint.) -->
            <joint name="world_fixed" type="fixed">
                <parent>world</parent>
                <child>base_link</child>
            </joint>

            <!-- Sliding part: the robot_side mesh, nested inside this model.
                 Pose is relative to the linear_stage model frame. Lift it clear
                 of the base box (box is 0.3 tall, so its top is at z=0.15) so the
                 mesh does not interpenetrate base_link's collision, which would
                 make the contact solver eject the links every step (jitter). -->
            <include>
                <uri>model://robot_side/</uri>
                <name>robot_side</name>
                <pose>0.0 0.0 0.05 0 0 0</pose>
            </include>

            <link name="vertical_link"/>

            <!-- Prismatic joint slides robot_side along Y relative to the base -->
            <joint name="vertical_joint" type="prismatic">
                <parent>base_link</parent>
                <child>vertical_link</child>
                <pose relative_to="base_link">0.0 -0.05 0.0 0 0 0</pose>
                <axis>
                    <xyz expressed_in="base_link">0 0 1</xyz>
                    <!-- lower MUST be <= upper. The range also has to include the
                         joint's rest position (0) so the joint does not start
                         outside its limits and fight the constraint. -->
                    <limit>
                        <lower>0</lower>
                        <upper>1</upper>
                    </limit>
                </axis>
            </joint>

            <link name="x_hor_link"/>

            <!-- Prismatic joint slides robot_side along Y relative to the base -->
            <joint name="x_hor_joint" type="prismatic">
                <parent>base_link</parent>
                <child>x_hor_link</child>
                <pose relative_to="base_link">0.0 -0.05 0.0 0 0 0</pose>
                <axis>
                    <xyz expressed_in="base_link">1 0 0</xyz>
                    <!-- lower MUST be <= upper. The range also has to include the
                         joint's rest position (0) so the joint does not start
                         outside its limits and fight the constraint. -->
                    <limit>
                        <lower>-1</lower>
                        <upper>1</upper>
                    </limit>
                </axis>
            </joint>

            <joint name="robot_side_joint" type="prismatic">
                <parent>vertical_link</parent>
                <child>robot_side::tool_mount</child>
                <pose relative_to="vertical_link">0.0 -0.05 0.0 0 0 0</pose>
                <axis>
                    <xyz expressed_in="vertical_link">0 1 0</xyz>
                    <!-- lower MUST be <= upper. The range also has to include the
                         joint's rest position (0) so the joint does not start
                         outside its limits and fight the constraint. -->
                    <limit>
                        <lower>-1</lower>
                        <upper>-0.05</upper>
                    </limit>
                </axis>
            </joint>

            <!-- Position controller. Publish a target position (metres) to
                 /linear_stage/cmd_pos as a gz.msgs.Double to move the joint. -->
            <plugin filename="gz-sim-joint-position-controller-system"
                    name="gz::sim::systems::JointPositionController">
                <joint_name>robot_side_joint</joint_name>
                <topic>/linear_stage/cmd_hor</topic>
                <initial_position>-0.05</initial_position>
                <p_gain>200</p_gain>
                <i_gain>10</i_gain>
                <d_gain>20</d_gain>
                <cmd_max>500</cmd_max>
                <cmd_min>-500</cmd_min>
            </plugin>

            <plugin filename="gz-sim-joint-position-controller-system"
                    name="gz::sim::systems::JointPositionController">
                <joint_name>vertical_joint</joint_name>
                <topic>/linear_stage/cmd_ver</topic>
                <initial_position>0.0</initial_position>
                <p_gain>2000</p_gain>
                <i_gain>10</i_gain>
                <d_gain>20</d_gain>
                <effort>2000</effort> 
                <cmd_max>2000</cmd_max>
                <cmd_min>-2000</cmd_min>
            </plugin>

            <plugin filename="gz-sim-joint-position-controller-system"
                    name="gz::sim::systems::JointPositionController">
                <joint_name>x_hor_joint</joint_name>
                <topic>/linear_stage/cmd_x_hor</topic>
                <initial_position>0.0</initial_position>
                <p_gain>2000</p_gain>
                <i_gain>10</i_gain>
                <d_gain>20</d_gain>
                <effort>2000</effort> 
                <cmd_max>2000</cmd_max>
                <cmd_min>-2000</cmd_min>
            </plugin>
        </model>

        <model name="rack">
            <include>
                <uri>model://tool_rack/</uri>
                <name>tool_rack</name>
                <pose>0.1025 -0.2 0.0 0 0 1.5707963267948966</pose>
            </include>
        </model>
        
    </world>
</sdf>