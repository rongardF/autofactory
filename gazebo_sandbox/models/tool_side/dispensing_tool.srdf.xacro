<?xml version="1.0" ?>
<sdf version="1.6" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="endtool"
      params="
        model_name:=endtool
        tool_mount_model:=tool_mount
        tool_mount_child_link:=mount_link
        tool_mount_topic_base:=/tool_mount
        tool_rack_model:=tool_rack
        tool_rack_child_link:=rack_link
        tool_rack_topic_base:=/tool_rack
        pp_publish_link_pose:=true
        pp_publish_collision_pose:=false
        pp_publish_visual_pose:=false
        pp_publish_nested_model_pose:=false
        pp_publish_model_pose:=false
        pp_use_pose_vector_msg:=true
        pp_update_frequency:=125">

    <model name="${model_name}">
      <link name="endtool_link">
        <inertial>
          <mass> 0.5094651951956418 </mass>
          <pose> -4.6297522176e-05 -2.7501563919e-02 -2.8689966722e-06 0 0 0 </pose>
          <inertia>
            <ixx>  1.8444458772e-04 </ixx>
            <ixy> -1.8714769888e-07 </ixy>
            <ixz>  2.5644282048e-08 </ixz>
            <iyy>  1.8051069194e-04 </iyy>
            <iyz>  4.2089057146e-08 </iyz>
            <izz>  2.0096567452e-04 </izz>
          </inertia>
        </inertial>
        <collision name="tool_collision">
          <geometry>
            <mesh>
              <uri>model://tool_side/meshes/collision_tool_side.stl</uri>
            </mesh>
          </geometry>
        </collision>
        <visual name="tool_visual">
          <geometry>
            <mesh>
              <uri>model://tool_side/meshes/visual_tool_side.dae</uri>
            </mesh>
          </geometry>
          <material>
              <ambient>1 0 0 1</ambient>
              <diffuse>1 0 0 1</diffuse>
          </material>
        </visual>
      </link>

      <!--
      IMPORTANT (gz-sim 8.11.0): this plugin STARTS ATTACHED. Its
      internal attachRequested flag defaults to true, so a fixed joint
      is created on the very first simulation step at the parts'
      INITIAL relative pose. There is no <start_detached> option in
      this version; <attach_topic> only RE-attaches after a detach.

      Parent_link must be a DIRECT link of the model hosting this
      plugin
      -->
      <plugin filename="gz-sim-detachable-joint-system"
              name="gz::sim::systems::DetachableJoint">
          <parent_link>endtool_link</parent_link>
          <child_model>${tool_mount_model}</child_model>
          <child_link>${tool_mount_child_link}</child_link>
          <attach_topic>${tool_mount_topic_base}/attach</attach_topic>
          <detach_topic>${tool_mount_topic_base}/detach</detach_topic>
          <output_topic>${tool_mount_topic_base}/state</output_topic>
      </plugin>

      <plugin filename="gz-sim-detachable-joint-system"
              name="gz::sim::systems::DetachableJoint">
          <parent_link>endtool_link</parent_link>
          <child_model>${tool_rack_model}</child_model>
          <child_link>${tool_rack_child_link}</child_link>
          <attach_topic>${tool_rack_topic_base}/attach</attach_topic>
          <detach_topic>${tool_rack_topic_base}/detach</detach_topic>
          <output_topic>${tool_rack_topic_base}/state</output_topic>
      </plugin>

      <!-- Publishes this model's world pose so it can be observed over the
      ROS graph. The SceneBroadcaster's /world/<world>/pose/info topic carries
      the entity name in gz.msgs.Pose.name, which the ros_gz_bridge Pose_V ->
      tf2_msgs/TFMessage converter does NOT copy into child_frame_id (it only
      reads header data keys "frame_id"/"child_frame_id"). PosePublisher DOES
      populate those header data entries, so the bridged TFMessage carries a
      real child_frame_id (this model's name) and frame_id (its parent).

      use_pose_vector_msg=true makes it publish a single gz.msgs.Pose_V on
      /model/<model_name>/pose, matching the bridge type below. -->
      <plugin filename="gz-sim-pose-publisher-system"
              name="gz::sim::systems::PosePublisher">
          <publish_link_pose>${pp_publish_link_pose}</publish_link_pose>
          <publish_collision_pose>${pp_publish_collision_pose}</publish_collision_pose>
          <publish_visual_pose>${pp_publish_visual_pose}</publish_visual_pose>
          <publish_nested_model_pose>${pp_publish_nested_model_pose}</publish_nested_model_pose>
          <publish_model_pose>${pp_publish_model_pose}</publish_model_pose>
          <use_pose_vector_msg>${pp_use_pose_vector_msg}</use_pose_vector_msg>
          <update_frequency>${pp_update_frequency}</update_frequency>
      </plugin>
    </model>

  </xacro:macro>

  <xacro:arg name="model_name"                  default="endtool"/>
  <xacro:arg name="tool_mount_model"            default="tool_mount"/>
  <xacro:arg name="tool_mount_child_link"       default="mount_link"/>
  <xacro:arg name="tool_mount_topic_base"       default="/tool_mount"/>
  <xacro:arg name="tool_rack_model"             default="tool_rack"/>
  <xacro:arg name="tool_rack_child_link"        default="rack_link"/>
  <xacro:arg name="tool_rack_topic_base"        default="/tool_rack"/>
  <xacro:arg name="pp_publish_link_pose"        default="true"/>
  <xacro:arg name="pp_publish_collision_pose"   default="false"/>
  <xacro:arg name="pp_publish_visual_pose"      default="false"/>
  <xacro:arg name="pp_publish_nested_model_pose" default="false"/>
  <xacro:arg name="pp_publish_model_pose"       default="false"/>
  <xacro:arg name="pp_use_pose_vector_msg"      default="true"/>
  <xacro:arg name="pp_update_frequency"         default="125"/>

  <!-- Instantiate the macro so `xacro endtool.xacro` emits a complete model.
       Each macro parameter is fed from its matching $(arg ...) so values passed
       on the xacro command line take effect. Include this file elsewhere and
       call <xacro:endtool .../> directly if you prefer to pass values inline. -->
  <xacro:endtool
      model_name="$(arg model_name)"
      tool_mount_model="$(arg tool_mount_model)"
      tool_mount_child_link="$(arg tool_mount_child_link)"
      tool_mount_topic_base="$(arg tool_mount_topic_base)"
      tool_rack_model="$(arg tool_rack_model)"
      tool_rack_child_link="$(arg tool_rack_child_link)"
      tool_rack_topic_base="$(arg tool_rack_topic_base)"
      pp_publish_link_pose="$(arg pp_publish_link_pose)"
      pp_publish_collision_pose="$(arg pp_publish_collision_pose)"
      pp_publish_visual_pose="$(arg pp_publish_visual_pose)"
      pp_publish_nested_model_pose="$(arg pp_publish_nested_model_pose)"
      pp_publish_model_pose="$(arg pp_publish_model_pose)"
      pp_use_pose_vector_msg="$(arg pp_use_pose_vector_msg)"
      pp_update_frequency="$(arg pp_update_frequency)"/>

</sdf>
