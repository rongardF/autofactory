<?xml version="1.0"?>
<sdf version="1.9">
  <model name="tool_1">
    <link name="tool_origin">
      <inertial><mass>0.5</mass><inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz></inertia></inertial>
      <collision name="c"><geometry><box><size>0.05 0.05 0.05</size></box></geometry></collision>
    </link>
    <plugin filename="gz-sim-detachable-joint-system" name="gz::sim::systems::DetachableJoint">
      <parent_link>tool_origin</parent_link>
      <child_model>station</child_model>
      <child_link>tool_mount_tcp</child_link>
      <attach_topic>/tool_mount_tcp/tool_1/attach</attach_topic>
      <detach_topic>/tool_mount_tcp/tool_1/detach</detach_topic>
      <output_topic>/tool_mount_tcp/tool_1/state</output_topic>
    </plugin>
    <plugin filename="gz-sim-detachable-joint-system" name="gz::sim::systems::DetachableJoint">
      <parent_link>tool_origin</parent_link>
      <child_model>station</child_model>
      <child_link>rack_link</child_link>
      <attach_topic>/rack_link/tool_1/attach</attach_topic>
      <detach_topic>/rack_link/tool_1/detach</detach_topic>
      <output_topic>/rack_link/tool_1/state</output_topic>
    </plugin>
  </model>
</sdf>
