# Capture a single image. The image returned was exposed after the goal was
# accepted, so frames taken while the robot was still moving are never returned.
---
# Result
sensor_msgs/Image image
sensor_msgs/CameraInfo camera_info
bool success
# Empty on success, otherwise describes the error.
string error_message
---
# Feedback (none)
