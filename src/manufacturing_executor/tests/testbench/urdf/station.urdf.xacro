<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="$(arg name)">
  <!-- robot name parameter -->
  <xacro:arg name="name" default="ur"/>
  <!-- import main macro -->
  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>

  <!-- import ros2_control joint control description -->
  <xacro:include filename="$(find ur_description)/urdf/inc/ur_joint_control.xacro" />

  <xacro:include filename="$(find cameras)/urdf/basler.urdf.xacro"/>
  <xacro:include filename="$(find laser_sensors)/urdf/cross_laser.urdf.xacro"/>
  <xacro:include filename="$(find tools_manager)/urdf/tool_mount.urdf.xacro"/>
  <xacro:include filename="$(find tools_manager)/urdf/tool_rack.urdf.xacro"/>
  <xacro:include filename="$(find product_carrier)/urdf/conveyor.urdf.xacro"/>
  <xacro:include filename="$(find rfid_scanner)/urdf/rfid_scanner.urdf.xacro"/>

  <!-- ros2_control macro (merged from ur_gz.ros2_control.xacro).
       Testbench: the initial pose is the station home pose with the arm turned towards the back
       of the station (shoulder pan within its limits [1.1, 6.28]), so the tool is not above the
       conveyor where the product arrives. -->
  <xacro:macro name="ur_ros2_control" params="
    name
    tf_prefix
    transmission_hw_interface:=hardware_interface/PositionJointInterface
    initial_positions:=${dict(shoulder_pan_joint=3.14,shoulder_lift_joint=-1.57,elbow_joint=-1.57,wrist_1_joint=-3.14,wrist_2_joint=-1.57,wrist_3_joint=0.0)}
    ">


    <!-- Add URDF transmission elements (for ros_control) -->
    <!--<xacro:ur_arm_transmission prefix="${prefix}" hw_interface="${transmission_hw_interface}" />-->
    <!-- Placeholder for ros2_control transmission which don't yet exist -->

    <ros2_control name="${name}" type="system">
      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>

      <xacro:ur_joint_control_description
        tf_prefix="${tf_prefix}"
        initial_positions="${initial_positions}"
      />
      </ros2_control>
  </xacro:macro>

  <!-- possible 'ur_type' values: ur3, ur3e, ur5, ur5e, ur7e, ur10, ur10e, ur12e, ur16e, ur8long, ur15, ur18, ur20, ur30 -->
  <!-- the default value should raise an error in case this was called without defining the type -->
  <xacro:arg name="ur_type" default="ur5x"/>

  <!-- parameters -->
  <xacro:arg name="tf_prefix" default="" />
  <xacro:arg name="joint_limit_params" default="$(find ur_description)/config/$(arg ur_type)/joint_limits.yaml"/>
  <xacro:arg name="kinematics_params" default="$(find ur_description)/config/$(arg ur_type)/default_kinematics.yaml"/>
  <xacro:arg name="physical_params" default="$(find ur_description)/config/$(arg ur_type)/physical_parameters.yaml"/>
  <xacro:arg name="visual_params" default="$(find ur_description)/config/$(arg ur_type)/visual_parameters.yaml"/>
  <xacro:arg name="transmission_hw_interface" default=""/>
  <xacro:arg name="safety_limits" default="false"/>
  <xacro:arg name="safety_pos_margin" default="0.15"/>
  <xacro:arg name="safety_k_position" default="20"/>

  <xacro:arg name="simulation_controllers" default="" />
  <xacro:arg name="ros_namespace" default="" />

  <!-- create link fixed to the "world" -->
  <link name="world" />

  <link name="ground_plane">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="5 5 0"/>
      </geometry>
      <material name="ground_white">
        <color rgba="1 1 1 0.5"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="5 5 0"/>
      </geometry>
    </collision>
  </link>

  <joint name="ground_plane_joint" type="fixed">
    <origin xyz="0 0 -0.01" rpy="0 0 0"/>
    <parent link="world"/>
    <child link="ground_plane"/>
  </joint>

  <!-- station pedestal on which the robot is mounted -->
  <link name="station">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find station)/config/model/station/meshes/station_visual.dae"/>
      </geometry>
      <material name="tool_rack_grey">
          <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find station)/config/model/station/meshes/station_collision.stl"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.5" rpy="0 0 0"/>
      <mass value="100.0"/>
      <inertia ixx="16.667" ixy="0" ixz="0" iyy="16.667" iyz="0" izz="16.667"/>
    </inertial>
  </link>

  <joint name="station_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="world"/>
    <child link="station"/>
  </joint>

  <!-- tool rack attached to station -->
  <xacro:tool_rack
    parent="station"
    simulated="true"
    rack_origin_xyz="-0.03 -0.427 0.9"
    rack_origin_rpy="0 0 1.5708"
    number_of_slots="2"
    slot_spacing="-0.25"
  />

  <xacro:cross_laser parent="station" name="captron" simulated="true" tf_prefix="$(arg tf_prefix)">
    <origin xyz="0.35 0.45 0.95" rpy="0 0 3.14"/>
  </xacro:cross_laser>

  <!-- arm mounted on top of the station (z=1.0) -->
  <xacro:ur_robot
    name="$(arg name)"
    tf_prefix="$(arg tf_prefix)"
    parent="station"
    joint_limits_parameters_file="$(arg joint_limit_params)"
    kinematics_parameters_file="$(arg kinematics_params)"
    physical_parameters_file="$(arg physical_params)"
    visual_parameters_file="$(arg visual_params)"
    safety_limits="$(arg safety_limits)"
    safety_pos_margin="$(arg safety_pos_margin)"
    safety_k_position="$(arg safety_k_position)"
    force_abs_paths="true"
    >
    <origin xyz="0.3 0 0.90001" rpy="0 0 0" />            <!-- position robot on top of station -->
  </xacro:ur_robot>

  <!-- tool mount attached to tool0 -->
  <xacro:tool_mount
    parent="tool0"
    simulated="true"
    mount_origin_xyz="0 0 0.0272"
    mount_origin_rpy="0 -1.5708 -1.5708"
  />

  <xacro:basler_camera parent="tool_mount_tcp" name="basler" simulated="true" tf_prefix="$(arg tf_prefix)">
    <origin xyz="-0.110 0.02 -0.0575" rpy="0.0 0 0.0"/>
  </xacro:basler_camera>

  <!--
    Testbench: the static conveyor of the station is replaced by the product_carrier conveyor
    (moving 'carrier' link, joint base_carrier_joint) and a SIMATIC RF240R RFID scanner below the
    in-place tag position, so the station_workplace node can run in simulation.

    conveyor_origin is placed so that the product spawned on the in-place carrier
    (carrier = conveyor_origin + (0.451 + q, 0.3, 0.84), q = base_carrier_joint in [-0.6, 0],
    product pose [-0.35, 0.25, 0.02] on the carrier) lies at about (0.85, 0.25, 0.86) in the world.
  -->
  <xacro:conveyor
    parent="world"
    simulated="true"
    mount_origin_xyz="0.749 -0.3 0"
    mount_origin_rpy="0 0 0"
  />

  <xacro:rfid_scanner
    device_type="simatic_rf240r"
    device_name="simatic_rf240r"
    simulated="true"
    parent="conveyor_origin"
    mount_origin_xyz="0.251 0.3 0.77"
    mount_origin_rpy="0 0 1.5708"
  />

  <gazebo reference="world">
  </gazebo>
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg simulation_controllers)</parameters>
      <ros>
        <namespace>$(arg ros_namespace)</namespace>
      </ros>
    </plugin>
  </gazebo>

  <!-- ros2 control instance -->
  <xacro:ur_ros2_control
    name="$(arg name)"
    tf_prefix="$(arg tf_prefix)"
    transmission_hw_interface="$(arg transmission_hw_interface)"
  />

</robot>