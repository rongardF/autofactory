<?xml version="1.0" ?>
 
<sdf version="1.6">
  <world name="default">

    <!-- <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics> -->
 
    <!-- Plugin for simulating physics -->
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
      <engine>
        <filename>libgz-physics-dartsim-plugin.so</filename>
      </engine>
    </plugin>
 
    <!-- Plugin for handling user commands -->
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
 
    <!-- Plugin for broadcasting scene updates -->
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
 
    <!-- Plugin for handling sensors like the LIDAR -->
    <!-- Using ogre (1.x) instead of ogre2 for better compatibility with software
         rendering (llvmpipe / XRDP). Switch to ogre2 if GPU passthrough is available. -->
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre</render_engine>
    </plugin>
 
    <!-- To add realistic gravity, do: 0.0 0.0 -9.8, otherwise do 0.0 0.0 0.0 -->
    <gravity>0.0 0.0 -9.8</gravity>
 
    <!-- Local directional light (replaces the remote Fuel Sun model to avoid network fetches) -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
 
    <!-- Ground plane with custom floor texture.
         The model lives in model/textured_ground/ so that GZ_SIM_RESOURCE_PATH
         (set in the launch file to <pkg_share>/model) resolves model:// URIs. -->
    <include>
      <uri>model://textured_ground</uri>
      <name>ground_plane</name>
    </include>
 
    <!-- Define scene properties -->
    <scene>
      <shadows>false</shadows>
    </scene>

    <!-- Dynamic box (0.5 x 0.5 x 0.05 m), gravity applies -->
    <model name="box">
      <pose>0.95 0 0.82 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>1.0</mass>
          <!-- inertia of a solid box 0.6 x 0.5 x 0.02 m: I = m/12*(a²+b²) -->
          <inertia>
            <ixx>0.02104</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.02104</iyy>
            <iyz>0</iyz>
            <izz>0.04167</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.6 0.5 0.02</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.6 0.5 0.02</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.5 0.8 1</ambient>
            <diffuse>0.2 0.5 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Calibration board placed at x=2, y=0, z=0 -->
    <include>
      <uri>model://calibration_board</uri>
      <name>calibration_board</name>
      <pose>0.95 0 0.85 0 0 0</pose>
    </include>

  </world>
</sdf>