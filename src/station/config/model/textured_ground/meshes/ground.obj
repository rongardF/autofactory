# Ground plane 10x10 m, normal +Z, centered at origin.
# UV coordinates run 0..20 so the albedo texture tiles every 0.5 m (20 tiles / 10 m).
mtllib ground.mtl
usemtl ground
v -5.0 -5.0 0.0
v  5.0 -5.0 0.0
v  5.0  5.0 0.0
v -5.0  5.0 0.0
vt 0.0 0.0
vt 20.0 0.0
vt 20.0 20.0
vt 0.0 20.0
vn 0.0 0.0 1.0
f 1/1/1 2/2/1 3/3/1
f 1/1/1 3/3/1 4/4/1
