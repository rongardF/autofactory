<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="ground_plane">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry>
          <plane>
            <normal>0 0 1</normal>
          </plane>
        </geometry>
        <surface>
          <friction>
            <torsional>
              <coefficient>0.0</coefficient>
            </torsional>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <!-- Textured mesh (not <plane>) so its UVs tile the albedo map every 5 m. -->
          <mesh>
            <uri>model://textured_ground/meshes/ground.obj</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>1.0 1.0 1.0 1.0</diffuse>
          <specular>0.2 0.2 0.2 1.0</specular>
          <!-- PBR albedo map is loaded directly by gz-sim (unlike <script>, which
               is a Gazebo-classic Ogre material script that gz-sim ignores).
               model:// resolves via GZ_SIM_RESOURCE_PATH, which the launch file
               points at the package's model/ directory. -->
          <pbr>
            <metal>
              <albedo_map>model://textured_ground/materials/textures/crop.png</albedo_map>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
