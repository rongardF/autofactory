# Acquire a new movement session (empty session_id) or extend the caller's
# existing session (non-empty session_id). While a session is active only
# execute_trajectory goals carrying its session_id are accepted.
string session_id
# Session timeout in seconds. -1 = use the node default ('session_timeout_s'
# parameter); > 0 = custom timeout; any other value is rejected.
float64 session_timeout_s
---
bool success
string error_message
# Session ID in force: the new ID when acquired, the same ID when extended.
string session_id
# Effective timeout applied, in seconds.
float64 session_timeout_s
