<?xml version="1.0"?>
<tool_mount xmlns:xacro="http://wiki.ros.org/xacro">

  <!--
    NOTE: Collisions between 'tool_mount_tcp' and its touch links are disabled
    in the SRDF (see tools_manager/srdf/tool_mount.srdf.xacro), NOT here.
    disable_collisions is an SRDF-only concept; MoveIt ignores it in the URDF.
  -->
  <xacro:macro name="tool_mount" params="
    parent:=tool0
    simulated:=true
    mount_origin_xyz:='0 0 0'
    mount_origin_rpy:='0 0 0'
    ">

    <link name="tool_mount_tcp">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="file://$(find tools_manager)/model/tool_mount/meshes/visual.dae"/>
            </geometry>
            <material name="tool_mount_grey">
                <color rgba="0.5 0.5 0.5 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="file://$(find tools_manager)/model/tool_mount/meshes/collision.stl"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="4.697067588322115"/>
            <inertia
                ixx="1.841474459710298"
                ixy="-0.004289082833111024"
                ixz="0.10558599010118996"
                iyy="1.824344061067677"
                iyz="0.029655588824880397"
                izz="2.055971309702727"/>
        </inertial>
    </link>

    <joint name="tool_mount_tcp_joint" type="fixed">
        <parent link="${parent}"/>
        <child link="tool_mount_tcp"/>
        <origin xyz="${mount_origin_xyz}" rpy="${mount_origin_rpy}"/>
    </joint>

    <!--
        Keep 'tool_mount_tcp' as a real SDF <link> so the tool model's Gazebo
        DetachableJoint can resolve it via model.LinkByName(). Without
        preserveFixedJoint the URDF->SDF converter lumps this fixed-joint child
        into its parent and demotes it to a <frame>, which the plugin cannot
        find (resulting in "Child Link tool_mount_tcp could not be found").
    -->
    <gazebo reference="tool_mount_tcp_joint">
        <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>

    <xacro:if value="${simulated}">
        <link name="rfid_scanner_link">
            <inertial>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <mass value="1e-6"/>
                <inertia ixx="1e-9" ixy="0" ixz="0" iyy="1e-9" iyz="0" izz="1e-9"/>
            </inertial>
        </link>

        <joint name="tool_mount_to_rfid_scanner_joint" type="fixed">
            <parent link="tool_mount_tcp"/>
            <child link="rfid_scanner_link"/>
            <origin xyz="0.0778 0 -0.033" rpy="0 0 0"/>
        </joint>

        <!--
            Keep the RFID frame as a real SDF <link> so the RfidReader plugin can
            resolve it via model.LinkByName(). Without preserveFixedJoint the URDF->SDF
            converter lumps this massless fixed-joint child into its parent and turns it
            into a <frame>, which the plugin cannot find (link resolver returns null).
        -->
        <gazebo reference="tool_mount_to_rfid_scanner_joint">
            <preserveFixedJoint>true</preserveFixedJoint>
        </gazebo>

        <gazebo>
            <plugin filename="rfid_sim_systems"
                    name="autofactory::rfid::RfidReader">
                <link>rfid_scanner_link</link>
                <range>0.1</range>
                <update_rate>10</update_rate>
                <detected_topic>/tool_mount_rfid_scanner/detected</detected_topic>
                <content_topic>/tool_mount_rfid_scanner/tag_data</content_topic>
                <reader_id>tool_mount_reader</reader_id>
            </plugin>
        </gazebo>
    </xacro:if>
  </xacro:macro>
</tool_mount>