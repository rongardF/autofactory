# Wait for the product carrier to route a product into (injection) or out of
# (ejection) the station workplace and for the workplace to settle.

# Goal
string ROUTING_OPERATION_INJECTION="injection"
string ROUTING_OPERATION_EJECTION="ejection"
# Either 'injection' or 'ejection'; any other value is rejected.
string routing_operation
---
# Result
# Time from goal start to completion [s], rounded down; always reported.
int32 routing_time_s
bool success
# Empty on success.
string error_message
# Product in the workplace after an injection (also on an unidentified product,
# with all fields 'UNKNOWN'); empty after an ejection or on any other failure.
ProductData[<=1] product_data
---
# Feedback (none)
