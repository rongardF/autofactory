# Spawn a product and its carrier into the Gazebo world (simulation only).
# Product data written to the carrier RFID tag / published as a barcode label.
string     product_number
string     product_revision
string     serial_number
# UUID4 of the SDF product model in the object model storage.
string     assembly_model_id
# Product pose [x, y, z, roll, pitch, yaw] (m, rad) relative to the carrier model's carrier link.
float64[6] pose
---
# True if both models were spawned.
bool       success
# Empty on success, human-readable reason on failure.
string     error_message
