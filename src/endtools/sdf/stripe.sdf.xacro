<?xml version="1.0" ?>
<sdf version="1.6" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="dispensed_stripe_model"
      params="
        model_name:=stripe_123
        anchor_model_name:=anchor
        anchor_link:=anchor_link
        radius_m:=0.02
        length_m:=0.1
        color_rgba:='0.33 0.66 0.99 1'
      ">

    <model name="${model_name}">
      <link name="putty_link">
        <inertial>
            <mass>1e-6</mass>
        </inertial>

        <visual name="stripe_cap_start_visual">
            <pose>0 0 0 0 0 0</pose>
            <geometry>
                <sphere>
                    <radius>${radius_m}</radius>
                </sphere>
            </geometry>
            <material>
              <ambient>${color_rgba}</ambient>
              <diffuse>${color_rgba}</diffuse>
            </material>
        </visual>
        <visual name="stripe_cylinder_visual">
            <pose>${length_m / 2.0} 0 0 0 ${pi / 2} 0</pose>
            <geometry>
                <cylinder>
                    <radius>${radius_m}</radius>
                    <length>${length_m}</length>
                </cylinder>
            </geometry>
            <material>
              <ambient>${color_rgba}</ambient>
              <diffuse>${color_rgba}</diffuse>
            </material>
        </visual>
        <visual name="stripe_cap_end_visual">
            <pose>${length_m} 0 0 0 0 0</pose>
            <geometry>
                <sphere>
                    <radius>${radius_m}</radius>
                </sphere>
            </geometry>
            <material>
              <ambient>${color_rgba}</ambient>
              <diffuse>${color_rgba}</diffuse>
            </material>
        </visual>
      </link>

      <!-- The anchor is the product for the first blob and the previously spawned blob
           afterwards. Welding every blob to the product makes gz-physics add a mirror
           body and a solver constraint per blob to the product skeleton, which slows the
           simulation down as blobs accumulate. Chaining keeps them plain tree welds. -->
      <plugin filename="gz-sim-detachable-joint-system"
                name="gz::sim::systems::DetachableJoint">
        <parent_link>putty_link</parent_link>
        <child_model>${anchor_model_name}</child_model>
        <child_link>${anchor_link}</child_link>
        <attach_topic>/${model_name}/attach</attach_topic>
        <detach_topic>/${model_name}/detach</detach_topic>
        <output_topic>/${model_name}/state</output_topic>
      </plugin>
    </model>

  </xacro:macro>

  <xacro:arg name="model_name"                  default="stripe_123"/>
  <xacro:arg name="anchor_model_name"          default="anchor"/>
  <xacro:arg name="anchor_link"             default="anchor_link"/>
  <xacro:arg name="radius_m"              default="0.02"/>
  <xacro:arg name="length_m"              default="0.1"/>
  <xacro:arg name="color_rgba"            default="0.33 0.66 0.99 1"/>

  <xacro:dispensed_stripe_model
      model_name="$(arg model_name)"
      anchor_model_name="$(arg anchor_model_name)"
      anchor_link="$(arg anchor_link)"
      radius_m="$(arg radius_m)"
      length_m="$(arg length_m)"
      color_rgba="$(arg color_rgba)"
  />

</sdf>
